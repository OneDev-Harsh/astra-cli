  "description": "AI-native development companion — Agent, Ask, and Plan modes in your terminal.",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "astra": "./index.ts"
  },
  "files": [
    "index.ts",
    "ai/",
    "modes/",
    "tui/",
    "session/",
    "core/",
    "game/",
